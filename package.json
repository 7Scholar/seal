{
  "name": "seal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-local": "scripts/update-local.sh",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:build": "bun run build && cargo build --release --manifest-path src-tauri/Cargo.toml --features e2e,custom-protocol",
    "e2e:extended": "wdio run e2e/wdio.conf.ts --spec e2e/journeys/first-run.e2e.ts --spec e2e/journeys/return-and-use.e2e.ts",
    "e2e:interrupted": "wdio run e2e/wdio.conf.ts --spec e2e/journeys/interrupted-rekey.e2e.ts",
    "e2e:living": "wdio run e2e/wdio.conf.ts --spec e2e/journeys/living-with-it.e2e.ts",
    "e2e:frame": "wdio run e2e/wdio.conf.ts --spec e2e/journeys/window-frame.e2e.ts",
    "e2e:expiry": "wdio run e2e/wdio.expiry.conf.ts",
    "e2e:settling": "wdio run e2e/wdio.settling.conf.ts",
    "e2e:deploy": "wdio run e2e/wdio.deploy.conf.ts",
    "e2e:badday": "wdio run e2e/wdio.badday.conf.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-service": "^1.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
