---
import { Icon } from "@astrojs/starlight/components";

interface Props {
  icon?: string;
  title: string;
  href: string;
  cta: string;
}

const { icon, title, href, cta } = Astro.props;
---

<a class="tile" href={href}>
  <span class="tile__title">
    {icon && <Icon name={icon} class="tile__icon" size="1.333em" />}
    <span set:html={title} />
  </span>

  <span class="tile__body"><slot /></span>

  <span class="tile__cta">
    <span>{cta}</span>
    <svg
      viewBox="0 0 18 18"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3.75 9h10.5"></path>
      <path d="M9.75 4.5 14.25 9l-4.5 4.5"></path>
    </svg>
  </span>
</a>

<style>
  /* A tile sits on the page rather than inside a box. Four bordered cards on a
     ground this quiet read as four panels of chrome competing with the words in
     them; space and the rule above the group separate them just as well. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.6875rem;
    padding: 0 2.5rem 0 0;
    border: 0;
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  /* The whole tile is the link, so its hover state is the title and the call to
     action together — with no border to take the accent, the type carries it,
     which is the reason the call to action is inside the anchor rather than
     beside it. */
  .tile:hover .tile__title {
    color: var(--sl-color-text-accent);
  }

  .tile:focus-visible {
    outline: var(--seal-focus-width) solid var(--seal-focus-color);
    outline-offset: 0.5rem;
    border-radius: var(--seal-radius-sm);
  }

  .tile__title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: var(--sl-line-height-headings);
    transition: color 150ms ease;
  }

  .tile__body {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-body-sm);
    line-height: 1.6;
  }

  /* Pushed to the tile's foot so every tile's call to action lines up whatever
     the description's length. */
  .tile__cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-body-sm);
    font-weight: 400;
    transition: color 150ms ease;
  }

  .tile:hover .tile__cta {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tile__cta svg {
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .tile:hover .tile__cta svg {
    transform: translateX(2px);
  }
</style>
