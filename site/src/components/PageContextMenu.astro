---
interface Props {
  markdownUrl: string;
}

const { markdownUrl } = Astro.props;
---

<seal-page-menu class="page-menu" data-markdown-url={markdownUrl}>
  <a class="page-menu__fallback" href={markdownUrl} target="_blank" rel="noopener" data-fallback>
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="1.25" y="4.5" width="17.5" height="11" rx="2.25"></rect>
      <path d="M4.75 12.75V7.25h.45L7.5 10.5l2.3-3.25h.45v5.5"></path>
      <path d="M13.75 7.25v4.25M11.9 9.9l1.85 1.85 1.85-1.85"></path>
    </svg>
    <span>View as Markdown</span>
  </a>

  <button type="button" class="page-menu__copy" data-copy aria-label="Copy page as Markdown" hidden>
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="copy">
      <rect x="7.25" y="7.25" width="9.5" height="9.5" rx="2.25"></rect>
      <path d="M13 4.75A2.25 2.25 0 0 0 10.75 3H5.25A2.25 2.25 0 0 0 3 5.25v5.5A2.25 2.25 0 0 0 5.25 13"></path>
    </svg>
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="done" hidden>
      <path d="M4.5 10.5 8 14l7.5-8"></path>
    </svg>
    <span class="page-menu__label">
      <span aria-hidden="true" class="page-menu__ghost">Copying…</span>
      <span data-copy-label>Copy page</span>
    </span>
  </button>

  <button
    type="button"
    class="page-menu__more"
    data-more
    aria-label="More actions"
    aria-haspopup="menu"
    aria-expanded="false"
    hidden
  >
    <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 8l4 4 4-4"></path>
    </svg>
  </button>

  <div class="page-menu__panel" data-panel role="menu" hidden>
    <a class="page-menu__item" role="menuitem" href={markdownUrl} target="_blank" rel="noopener">
      <span class="page-menu__frame">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1.25" y="4.5" width="17.5" height="11" rx="2.25"></rect>
          <path d="M4.75 12.75V7.25h.45L7.5 10.5l2.3-3.25h.45v5.5"></path>
          <path d="M13.75 7.25v4.25M11.9 9.9l1.85 1.85 1.85-1.85"></path>
        </svg>
      </span>
      <span>
        <strong>View as Markdown <svg class="page-menu__out" viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.25 2.75 2.9 9.1"></path><path d="M3.6 2.75h5.65V8.4"></path></svg></strong>
        <small>View this page as plain text</small>
      </span>
    </a>

    <button type="button" class="page-menu__item" role="menuitem" data-claude>
      <span class="page-menu__frame">
        <svg viewBox="0 0 256 257" width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
          <path d="m50.228 170.321 50.357-28.257.843-2.463-.843-1.361h-2.462l-8.426-.518-28.775-.778-24.952-1.037-24.175-1.296-6.092-1.297L0 125.796l.583-3.759 5.12-3.434 7.324.648 16.202 1.101 24.304 1.685 17.629 1.037 26.118 2.722h4.148l.583-1.685-1.426-1.037-1.101-1.037-25.147-17.045-27.22-18.017-14.258-10.37-7.713-5.25-3.888-4.925-1.685-10.758 7-7.713 9.397.649 2.398.648 9.527 7.323 20.35 15.75L94.817 91.9l3.889 3.24 1.555-1.102.195-.777-1.75-2.917-14.453-26.118-15.425-26.572-6.87-11.018-1.814-6.61c-.648-2.723-1.102-4.991-1.102-7.778l7.972-10.823L71.42 0 82.05 1.426l4.472 3.888 6.61 15.101 10.694 23.786 16.591 32.34 4.861 9.592 2.592 8.879.973 2.722h1.685v-1.556l1.36-18.211 2.528-22.36 2.463-28.776.843-8.1 4.018-9.722 7.971-5.25 6.222 2.981 5.12 7.324-.713 4.73-3.046 19.768-5.962 30.98-3.889 20.739h2.268l2.593-2.593 10.499-13.934 17.628-22.036 7.778-8.749 9.073-9.657 5.833-4.601h11.018l8.1 12.055-3.628 12.443-11.342 14.388-9.398 12.184-13.48 18.147-8.426 14.518.778 1.166 2.01-.194 30.46-6.481 16.462-2.982 19.637-3.37 8.88 4.148.971 4.213-3.5 8.62-20.998 5.184-24.628 4.926-36.682 8.685-.454.324.519.648 16.526 1.555 7.065.389h17.304l32.21 2.398 8.426 5.574 5.055 6.805-.843 5.184-12.962 6.611-17.498-4.148-40.83-9.721-14-3.5h-1.944v1.167l11.666 11.406 21.387 19.314 26.767 24.887 1.36 6.157-3.434 4.86-3.63-.518-23.526-17.693-9.073-7.972-20.545-17.304h-1.36v1.814l4.73 6.935 25.017 37.59 1.296 11.536-1.814 3.76-6.481 2.268-7.13-1.297-14.647-20.544-15.1-23.138-12.185-20.739-1.49.843-7.194 77.448-3.37 3.953-7.778 2.981-6.48-4.925-3.436-7.972 3.435-15.749 4.148-20.544 3.37-16.333 3.046-20.285 1.815-6.74-.13-.454-1.49.194-15.295 20.999-23.267 31.433-18.406 19.702-4.407 1.75-7.648-3.954.713-7.064 4.277-6.286 25.47-32.405 15.36-20.092 9.917-11.6-.065-1.686h-.583L44.07 198.125l-12.055 1.555-5.185-4.86.648-7.972 2.463-2.593 20.35-13.999-.064.065Z"></path>
        </svg>
      </span>
      <span>
        <strong>Open in Claude <svg class="page-menu__out" viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.25 2.75 2.9 9.1"></path><path d="M3.6 2.75h5.65V8.4"></path></svg></strong>
        <small>Ask questions about this page</small>
      </span>
    </button>
  </div>
</seal-page-menu>

<style>
  .page-menu {
    display: flex;
    align-items: stretch;
    position: relative;
    flex-shrink: 0;
  }

  /* `display` on the rules below would otherwise defeat the attribute. */
  .page-menu [hidden] {
    display: none !important;
  }

  .page-menu__fallback,
  .page-menu__copy,
  .page-menu__more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.125rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  /* The anchor is what a reader without JavaScript gets, so it stands alone. */
  .page-menu__fallback {
    padding-inline: 0.75rem;
    border-radius: var(--seal-radius-control);
    text-decoration: none;
    white-space: nowrap;
  }

  .page-menu__copy {
    padding-inline: 0.75rem;
    border-radius: var(--seal-radius-control) 0 0 var(--seal-radius-control);
    border-inline-end: 0;
  }

  .page-menu__more {
    padding-inline: 0.5rem;
    border-radius: 0 var(--seal-radius-control) var(--seal-radius-control) 0;
    color: var(--sl-color-gray-3);
  }

  .page-menu__fallback:hover,
  .page-menu__copy:hover,
  .page-menu__more:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .page-menu__fallback:focus-visible,
  .page-menu__copy:focus-visible,
  .page-menu__more:focus-visible,
  .page-menu__item:focus-visible {
    outline: var(--seal-focus-width) solid var(--seal-focus-color);
    outline-offset: var(--seal-focus-offset);
  }

  /* The ghost label reserves the widest string so the button never resizes. */
  .page-menu__label {
    display: grid;
  }
  .page-menu__label > * {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  .page-menu__ghost {
    visibility: hidden;
  }

  .page-menu__panel {
    position: absolute;
    inset-block-start: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: 20;
    min-width: 17.5rem;
    padding: 0.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--seal-radius-container);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
  }

  .page-menu__item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border: 0;
    border-radius: var(--seal-radius-control);
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .page-menu__item:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  /* The icon is framed rather than left loose beside the text: at the size a
     menu row wants, a bare glyph reads as a stray mark, and the frame is what
     gives it the same weight as the two lines it sits against. */
  .page-menu__frame {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 2rem;
    block-size: 2rem;
    margin-block-start: 0.1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--seal-radius-control);
    color: var(--sl-color-gray-2);
  }

  .page-menu__item:hover .page-menu__frame {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .page-menu__frame svg {
    flex-shrink: 0;
  }

  .page-menu__item strong {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 500;
  }

  /* Both items open a new tab, which the label says rather than leaving the
     reader to discover it. */
  .page-menu__out {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .page-menu__item small {
    display: block;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
</style>

<script>
  class SealPageMenu extends HTMLElement {
    connectedCallback() {
      const markdownUrl = this.dataset.markdownUrl;
      const fallback = this.querySelector("[data-fallback]");
      const copy = this.querySelector("[data-copy]");
      const more = this.querySelector("[data-more]");
      const panel = this.querySelector("[data-panel]");
      const label = this.querySelector("[data-copy-label]");
      const copyIcon = this.querySelector('[data-icon="copy"]');
      const doneIcon = this.querySelector('[data-icon="done"]');

      // The split button replaces the plain anchor only once it can actually work.
      fallback.hidden = true;
      copy.hidden = false;
      more.hidden = false;

      const absolute = new URL(markdownUrl, location.href).href;

      const items = () => Array.from(panel.querySelectorAll('[role="menuitem"]'));

      // Focus returns to the trigger, so a keyboard reader is never dropped at
      // the top of the document after dismissing the menu.
      const close = (returnFocus) => {
        if (panel.hidden) return;
        panel.hidden = true;
        more.setAttribute("aria-expanded", "false");
        if (returnFocus) more.focus();
      };

      const open = (focusFirst) => {
        panel.hidden = false;
        more.setAttribute("aria-expanded", "true");
        if (focusFirst) items()[0]?.focus();
      };

      more.addEventListener("click", (event) => {
        event.stopPropagation();
        panel.hidden ? open(false) : close(false);
      });

      more.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open(true);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          open(false);
          items().at(-1)?.focus();
        }
      });

      panel.addEventListener("keydown", (event) => {
        const list = items();
        const at = list.indexOf(document.activeElement);
        if (event.key === "ArrowDown") {
          event.preventDefault();
          list[(at + 1) % list.length]?.focus();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          list[(at - 1 + list.length) % list.length]?.focus();
        } else if (event.key === "Home") {
          event.preventDefault();
          list[0]?.focus();
        } else if (event.key === "End") {
          event.preventDefault();
          list.at(-1)?.focus();
        } else if (event.key === "Tab") {
          close(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (!this.contains(event.target)) close(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") close(this.contains(document.activeElement));
      });

      this.querySelector("[data-claude]").addEventListener("click", () => {
        const question = `Read from ${absolute} so I can ask questions about it.`;
        window.open(`https://claude.ai/new?q=${encodeURIComponent(question)}`, "_blank", "noopener");
        close(true);
      });

      copy.addEventListener("click", async () => {
        label.textContent = "Copying\u2026";
        try {
          const response = await fetch(markdownUrl);
          if (!response.ok) throw new Error(String(response.status));
          await navigator.clipboard.writeText(await response.text());
          label.textContent = "Copied";
          copyIcon.hidden = true;
          doneIcon.hidden = false;
        } catch {
          // A refused clipboard must say so rather than look like a dead button.
          label.textContent = "Opened instead";
          window.open(markdownUrl, "_blank", "noopener");
        }
        setTimeout(() => {
          label.textContent = "Copy page";
          copyIcon.hidden = false;
          doneIcon.hidden = true;
        }, 2000);
      });
    }
  }

  customElements.define("seal-page-menu", SealPageMenu);
</script>
