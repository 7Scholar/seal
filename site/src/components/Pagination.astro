---
const { pagination } = Astro.props;
const { prev, next } = pagination;
---

<nav class="pager" aria-label="Previous and next page">
  {
    prev && (
      <a class="pager__link pager__link--prev" href={prev.href} rel="prev">
        <svg
          viewBox="0 0 20 20"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12.5 4.5 7 10l5.5 5.5" />
        </svg>
        <span class="pager__text">
          <span class="pager__dir">Previous</span>
          <span class="pager__title">{prev.label}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a class="pager__link pager__link--next" href={next.href} rel="next">
        <span class="pager__text">
          <span class="pager__dir">Next</span>
          <span class="pager__title">{next.label}</span>
        </span>
        <svg
          viewBox="0 0 20 20"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7.5 4.5 13 10l-5.5 5.5" />
        </svg>
      </a>
    )
  }
</nav>

<style>
  .pager {
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-block-start: 1rem;
  }

  /* A lone next link stays on the right, where a next link belongs. */
  .pager__link--next:only-child {
    margin-inline-start: auto;
  }

  .pager__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 22rem;
    padding: 0.5rem 0.65rem;
    margin-inline: -0.65rem;
    border-radius: var(--seal-radius-control);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .pager__link:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .pager__link:focus-visible {
    outline: var(--seal-focus-width) solid var(--seal-focus-color);
    outline-offset: var(--seal-focus-offset);
  }

  .pager__link svg {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .pager__link:hover svg {
    color: var(--sl-color-text-accent);
  }

  .pager__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .pager__link--next .pager__text {
    text-align: end;
  }

  .pager__dir {
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .pager__title {
    font-size: var(--sl-text-base);
    font-weight: 500;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
</style>
