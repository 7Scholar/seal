---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";

const { sidebar } = Astro.props;

const isLink = (entry) => entry.type === "link";
---

<nav class="sidebar" aria-label="Documentation">
  {
    sidebar.map((entry) =>
      isLink(entry) ? (
        <ul class="sidebar__list sidebar__list--loose">
          <li data-active={entry.isCurrent ? "" : undefined}>
            <a href={entry.href} aria-current={entry.isCurrent && "page"}>
              {entry.label}
            </a>
          </li>
        </ul>
      ) : (
        <div class="sidebar__group">
          <h2 class="sidebar__heading">{entry.label}</h2>
          <ul class="sidebar__list">
            {entry.entries.map((child) => (
              <li data-active={child.isCurrent ? "" : undefined}>
                <a href={child.href} aria-current={child.isCurrent && "page"}>
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    )
  }
</nav>

<div class="md:sl-hidden">
  <MobileMenuFooter {...Astro.props} />
</div>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.625rem;
  }

  .sidebar__heading {
    margin: 0 0 0.55rem;
    padding-inline: var(--seal-lane);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* The bar sits in a lane of its own at the far left, so a name never shifts
     when its page becomes the current one — the same reason the application's
     file rows reserve the lane on every row rather than only the marked ones. */
  .sidebar__list a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 1.9375rem;
    padding: 0.25rem 0.625rem 0.25rem 0;
    border-radius: var(--seal-radius-sm);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-base);
    line-height: 1.4;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .sidebar__list a::before {
    content: "";
    flex: none;
    width: var(--seal-bar);
    height: 1rem;
    background: transparent;
  }

  .sidebar__list a:hover {
    color: var(--sl-color-white);
    background: var(--seal-hover);
  }

  .sidebar__list a:focus-visible {
    outline: var(--seal-focus-width) solid var(--seal-focus-color);
    outline-offset: calc(-1 * var(--seal-focus-offset));
  }

  /* The active state is held on the item and styled through the link. */
  .sidebar__list li[data-active] > a,
  .sidebar__list li[data-active] > a:hover {
    color: var(--sl-color-white);
    background: var(--seal-accent-surface);
    font-weight: 500;
  }

  .sidebar__list li[data-active] > a::before {
    background: var(--sl-color-accent);
  }

  /* The threat-model page wears the danger bar whether or not it is current —
     which is why this rule sits after the active one and outweighs it. It is
     the one page whose relegation the site plan forbids: a mark that appears
     only on arrival cannot stop a reader passing it by, and one that
     disappears on arrival is the same failure from the other side. */
  .sidebar__list li a[href$="/understand/limits/"]::before,
  .sidebar__list li a[href$="/understand/limits"]::before {
    background: var(--seal-danger);
  }
</style>
